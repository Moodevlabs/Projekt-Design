VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Adres, pod ktorym stoi apps/share — strona klienta (oferty /q/ i briefy /b/).
#
# Produkcja: https://klient.toolier.pl   Lokalnie: http://localhost:1430
#
# Sam adres hosta, BEZ sciezki na koncu: aplikacja sama dokleja /q/{token}
# i /b/{token}, a hosting przepisuje na aplikacje wylacznie te dwa prefiksy.
#
# Wartosc jest WKOMPILOWYWANA w aplikacje w chwili budowania wydania, wiec
# jej zmiana wymaga nowego wydania. Przy VITE_APP_ENV=prod build przerywa sie,
# gdy adres jest pusty albo ma zly ksztalt (src/domain/share/base-url.ts).
VITE_SHARE_BASE_URL=
VITE_APP_ENV=local

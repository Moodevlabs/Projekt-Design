{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Uprawnienia głównego okna aplikacji.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://checkout.stripe.com/*" },
        { "url": "https://billing.stripe.com/*" },
        { "url": "https://*.supabase.co/*" },
        { "url": "https://toolier.pl/*" },
        { "url": "https://*.toolier.pl/*" },
        { "url": "http://localhost:*/*" },
        { "url": "mailto:*" },
        { "url": "https://*/*" },
        { "url": "http://*/*" }
      ]
    },
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}

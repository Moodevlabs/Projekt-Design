{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anzorge",
  "version": "0.1.0",
  "identifier": "pl.anzorge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anzorge",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://*.supabase.in http://127.0.0.1:54321 ws://127.0.0.1:54321"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anzorge"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Anzorge",
    "category": "Business",
    "shortDescription": "Interaktywne wyceny",
    "longDescription": "Anzorge — buduj interaktywne wyceny z pozycjami TAK/NIE i eksportuj brandowany PDF."
  }
}
